# 默认无需此文件，使用现有 SQLite 数据库。
# 使用 PostgreSQL 时复制为 .env，并填写自己的数据库密码。
SPRING_PROFILES_ACTIVE=postgres
DB_URL=jdbc:postgresql://localhost:5432/radio_submissions
DB_USER=radio
DB_PASSWORD=replace-with-your-password
PORT=8000

# 公网部署：将此域名解析到服务器，使用 docker compose --profile https up -d --build。
BROADCAST_DOMAIN=radio.example.com
REQUIRE_HTTPS=true
TRUSTED_PROXY_CIDRS=172.30.16.2/32
# 首次初始化可设置自己的强密码；留空则默认账号首次登录必须改密。
BROADCAST_ADMIN_PASSWORD=
# 可信代理必须覆盖转发头；不要把纯 TCP 的 FRP 通道当成可信 HTTP 代理。
# jar 的密钥默认写入 ./secrets；备份时与数据库分开加密保存。
