{$BROADCAST_DOMAIN} {
    # 将真实域名解析到云服务器后，Caddy 自动申请并续期 HTTPS 证书。
    request_body {
        max_size 64KB
    }
    reverse_proxy app:8000 {
        # 重新生成代理头，不接受客户端自己声称的 IP、协议和域名。
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up -Forwarded
    }
}
